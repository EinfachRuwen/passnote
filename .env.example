# PassNote – Umgebungsvariablen
# Kopiere diese Datei: cp .env.example .env
# Passe die Werte an und starte dann: docker compose up -d

# HTTP-Port der Anwendung (muss mit docker-compose.yml übereinstimmen)
PORT=3000

# Admin-Passwort für das Admin-Panel – UNBEDINGT ändern!
ADMIN_PASSWORD=sicher_aendern

# Pfad zur SQLite-Datenbankdatei (relativ zum Working Directory /app)
DB_PATH=./data/passnote.db

# Maximale Anzahl gleichzeitiger Benutzer pro Raum (Standard: 50)
MAX_USERS_DEFAULT=50

# Intervall für den automatischen Cleanup inaktiver Räume (in Stunden)
CLEANUP_INTERVAL_HOURS=24

# Zeit bis ein Raum automatisch gelöscht wird (in Millisekunden)
# Standard: 604800000 ms = 7 Tage
ROOM_TTL_MS=604800000
